PROJECT_NAME=FASTAPI_BASE
DEBUG=true
# DEBUG=false
SECRET_KEY=123456

POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

BACKEND_CORS_ORIGINS=["*"]

API_PREFIX=/api
API_VERSIONS=v1,v2
API_VERSION=v2

KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_VERIFY=false

GOOGLE_CLIENT_ID=

# OCR pipeline
UPLOAD_DIR=/app/mount-data/uploads
OCR_MAX_UPLOAD_MB=10
OCR_LANG=en
OCR_DEVICE=cpu
OCR_DET_MODEL=
OCR_REC_MODEL=
OCR_LOW_CONFIDENCE=0.8
OCR_REVIEW_CONFIDENCE=0.75
OCR_MAX_FIX_ROUNDS=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT=120
SANDBOX_TIMEOUT=15
SANDBOX_MEMORY=256m
SANDBOX_CPUS=0.5
# e.g. runsc when gVisor is installed on the Docker host
SANDBOX_RUNTIME=
