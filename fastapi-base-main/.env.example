PROJECT_NAME=FASTAPI_BASE
DEBUG=true
# DEBUG=false
SECRET_KEY=123456

POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

BACKEND_CORS_ORIGINS=["*"]

API_PREFIX=/api
API_VERSIONS=v1,v2
API_VERSION=v2

KEYCLOAK_SERVER_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_VERIFY=false

GOOGLE_CLIENT_ID=

# ---------- LLM ----------
# mock   : không gọi LLM thật (dev/test, không cần API key)
# openai : API theo chuẩn OpenAI Chat Completions (OpenAI, Gemini, Groq, OpenRouter, Ollama, vLLM...)
LLM_PROVIDER=mock
# Nhóm đang dùng OpenRouter:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   OPENROUTER_API_KEY=sk-or-...        (hoặc LLM_API_KEY=sk-or-...)
#   LLM_MODEL=deepseek/deepseek-v4.1-flash   (tên model copy từ trang openrouter.ai, dạng hãng/tên-model)
# Ví dụ Ollama chạy local:   LLM_BASE_URL=http://localhost:11434/v1   LLM_MODEL=qwen2.5-coder:7b
# (chạy trong docker-compose thì dùng http://host.docker.internal:11434/v1)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
# Một số server không hỗ trợ response_format=json_object -> đặt false
LLM_JSON_MODE=true
LLM_MIN_SIMILARITY=0.7
# Dòng nào LLM sửa mà giống dòng OCR dưới ngưỡng này thì coi là sửa quá nhiều (đánh dấu / trả lại theo LLM_GUARD_MODE)
LLM_MIN_LINE_SIMILARITY=0.5
# Thay đổi đáng ngờ của LLM ở /correct-ocr: flag = chỉ đánh dấu (mặc định), revert = đặt lại bản OCR gốc
LLM_GUARD_MODE=flag
